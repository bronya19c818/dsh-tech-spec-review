# Use: uv run --env-file .env ts-review ...
# All keys stay in local environment. Do not copy production credentials into source files.
TSR_MODEL_BASE_URL=
TSR_MODEL=
TSR_MODEL_API_KEY=
# Semantic candidates come directly from the Dify search MCP; exact rules and
# catalog data come from the separate Registry MCP. Never commit credentials.
TSR_RULES_BACKEND=mcp
TSR_MCP_CONFIG=现有暴露MCP工具/technical_spec_review_rules_search.json
TSR_CATALOG_MCP_CONFIG=现有暴露MCP工具/technical-spec-rule-registry.json
# Optional Docker host bridge for a semantic endpoint configured with localhost.
# docker-compose.yml sets this to host.docker.internal for Docker Desktop.
TSR_MCP_ENDPOINT_HOST_OVERRIDE=
TSR_MCP_HOST=127.0.0.1
TSR_MCP_PORT=8775
# Compose deployment defaults. The linked Registry directory contains its own
# ignored .env with POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD.
TSR_REGISTRY_ROOT=./现有结构化规则库
TSR_POSTGRES_VOLUME=sisync-postgres_sisync_pgdata
# The following direct HTTP/PostgreSQL/Dify options are only used with TSR_RULES_BACKEND=http.
TSR_REGISTRY_URL=http://127.0.0.1:8000
TSR_REGISTRY_API_KEY=
# Existing PostgreSQL, preferably a SELECT-only account. Catalog metadata only.
TSR_DATABASE_URL=postgresql://readonly_user:password@127.0.0.1:5432/rule_registry
TSR_DIFY_BASE_URL=http://127.0.0.1/v1
TSR_DIFY_DATASET_ID=
TSR_DIFY_API_KEY=
TSR_DOCUMENT_ROOT=.
TSR_RUNS_DIR=runs
TSR_CONCURRENCY=4
# B02 sentence-level model calls; independent from the overall task concurrency.
TSR_B02_CONCURRENCY=8
